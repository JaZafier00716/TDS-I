<TableView class="oracle.dbtools.crest.model.design.relational.TableView" directorySegmentName="seg_0" id="CF1630F4-9EB0-F654-1452-41FFAAB741FE" name="v_menu_revision_totals">
<sourceDDLFile>01_schema.sql</sourceDDLFile>
<createdBy>jan</createdBy>
<createdTime>2026-11-16 22:01:22 UTC</createdTime>
<ownerDesignName>catering</ownerDesignName>
<importedID>A03283D8-BF85-F12E-B057-B1906C3D1A1D</importedID>
<userDefined>true</userDefined>
<userDefinedSQL><![CDATA[SELECT r.menu_id,
       r.revision_no,
       m.project_id,
       m.name                                   AS menu_name,
       r.state,
       r.created_at,
       COUNT(i.product_id)                      AS item_count,
       NVL(SUM(i.quantity * i.unit_price), 0)   AS total_price,
       ROUND(NVL(SUM(i.quantity * i.unit_price), 0) / p.guest_count, 2) AS price_per_guest
FROM menu_revisions r
JOIN menus m           ON m.menu_id = r.menu_id
JOIN projects p        ON p.project_id = m.project_id
LEFT JOIN menu_categories c ON c.menu_id = r.menu_id AND c.revision_no = r.revision_no
LEFT JOIN menu_items i ON i.category_id = c.category_id
GROUP BY r.menu_id, r.revision_no, m.project_id, m.name, r.state, r.created_at, p.guest_count]]></userDefinedSQL>
